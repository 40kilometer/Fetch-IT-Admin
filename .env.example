# Fetch Staff Portal — environment variables
# Copy this file to `.env` for local development, and add the same variables
# in Vercel → Project → Settings → Environment Variables for deployment.

# Shared Neon database, using a separate restricted staff-runtime login.
# Apply the customer migration and setup-runtime-roles.sql before deployment.
# Do not use the maintenance/table-owner connection.
DATABASE_URL=postgresql://STAFF_LOGIN:REPLACE_ME@YOUR_NEON_HOST/neondb?sslmode=require

# Required in production: a separate secret of 32 random bytes (64 hex characters).
# Missing, short or sample secrets prevent admin sign-in.
ADMIN_SESSION_SECRET=

# ePOD photos: use the SAME PRIVATE Vercel Blob store in all Fetch apps.
# Connected Vercel projects use OIDC with this store ID.
BLOB_STORE_ID=
# Local development or cross-account fallback; server-only, never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
